<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pethealth.passport.ui.home.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/petListFragment"
        android:name="com.pethealth.passport.ui.pets.PetListFragment"
        android:label="@string/pet_list_title" />

    <fragment
        android:id="@+id/communityFragment"
        android:name="com.pethealth.passport.ui.community.CommunityFragment"
        android:label="@string/community_title" />

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.pethealth.passport.ui.more.MoreFragment"
        android:label="@string/nav_more" />

    <fragment
        android:id="@+id/petDetailFragment"
        android:name="com.pethealth.passport.ui.pets.PetDetailFragment"
        android:label="@string/pet_detail_title">
        <argument android:name="petId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/petEditFragment"
        android:name="com.pethealth.passport.ui.pets.PetEditFragment"
        android:label="@string/pet_edit_title">
        <argument android:name="petId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/vaccinationListFragment"
        android:name="com.pethealth.passport.ui.health.VaccinationListFragment"
        android:label="@string/vaccinations_title">
        <argument android:name="petId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/vaccinationEditFragment"
        android:name="com.pethealth.passport.ui.health.VaccinationEditFragment"
        android:label="@string/vaccination_add">
        <argument android:name="petId" app:argType="long" />
        <argument android:name="vaccinationId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/medicalListFragment"
        android:name="com.pethealth.passport.ui.health.MedicalListFragment"
        android:label="@string/medical_title">
        <argument android:name="petId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/medicalEditFragment"
        android:name="com.pethealth.passport.ui.health.MedicalEditFragment"
        android:label="@string/medical_add">
        <argument android:name="petId" app:argType="long" />
        <argument android:name="recordId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/weightFragment"
        android:name="com.pethealth.passport.ui.health.WeightFragment"
        android:label="@string/weight_title">
        <argument android:name="petId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.pethealth.passport.ui.community.CreatePostFragment"
        android:label="@string/community_write_post" />

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.pethealth.passport.ui.community.PostDetailFragment"
        android:label="@string/community_post_title">
        <argument android:name="postId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/tipsFragment"
        android:name="com.pethealth.passport.ui.content.TipsFragment"
        android:label="@string/tips_title" />

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.pethealth.passport.ui.content.QuizFragment"
        android:label="@string/quiz_title" />

    <fragment
        android:id="@+id/clinicsFragment"
        android:name="com.pethealth.passport.ui.content.ClinicsFragment"
        android:label="@string/clinics_title" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.pethealth.passport.ui.settings.SettingsFragment"
        android:label="@string/settings_title" />
</navigation>
